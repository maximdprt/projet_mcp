# Copier en .env (le .env n'est jamais rendu ni versionné).

# "simulation" : API simulées + entreprises fictives (démo hors ligne, reproductible)
# "reel"       : les 6 vraies API publiques
VERIF_MODE=simulation

# --- CRM -------------------------------------------------------------------
# La SEULE clé du projet. Le MCP n'a que CRM_CLE_MCP : elle permet de lire et d'enregistrer un résultat
# de vérification, rien d'autre. CRM_CLE_ADMIN (humains) permet valider / payer / changer un IBAN.
# CHANGEZ ces valeurs. Elles doivent être DIFFÉRENTES (sinon le CRM refuse de démarrer).
CRM_URL=http://127.0.0.1:8000
CRM_CLE_MCP=cle-mcp-demo-a-changer
CRM_CLE_ADMIN=cle-admin-demo-a-changer
# Mode présentation (oral) : 1 = le navigateur de cette machine agit comme administrateur sans saisir de clé.
# Réservé à 127.0.0.1 ; la clé du MCP reste limitée. Mettre 0 en dehors d'une démo.
CRM_MODE_PRESENTATION=0

# --- Appels aux API ----------------------------------------------------------
VERIF_USER_AGENT="verif-fournisseur-mcp/2.0 (projet etudiant)"
VERIF_TIMEOUT_SECONDES=10
VERIF_TIMEOUT_GELS_SECONDES=30
VERIF_APPELS_PAR_SECONDE=5
VERIF_CACHE_GELS_HEURES=6

# --- Règles métier (déterministes) ----------------------------------------
VERIF_JOURS_ENTREPRISE_RECENTE=180
VERIF_SEUIL_DOUBLE_VALIDATION_EUR=10000
VERIF_FACTEUR_MONTANT_ANORMAL=3
VERIF_SCORE_ADRESSE_MINIMUM=0.5
